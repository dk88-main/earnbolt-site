DirectoryIndex index.html index.php
Options +FollowSymLinks
RewriteEngine On

# Simple redirect for invite URLs
RewriteRule ^invite/([A-Z0-9]+)/?$ invite/index.html?code=$1 [L,QSA]

# Redirect IBD3D files to separate GitHub repo
RewriteRule ^IBD3D/(.+)$ https://github.com/dk88-main/earnbolt-files/raw/main/$1 [R=302,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]