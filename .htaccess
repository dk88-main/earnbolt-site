DirectoryIndex index.html index.php
Options +FollowSymLinks
RewriteEngine On

# Simple redirect for invite URLs
RewriteRule ^invite/([A-Z0-9]+)/?$ invite/index.html?code=$1 [L,QSA]

# Map IBD3D to IBD3D FILES folder for direct downloads
RewriteRule ^IBD3D/(.+)$ "IBD3D FILES/$1" [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]