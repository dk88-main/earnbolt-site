DirectoryIndex index.html index.php
Options +FollowSymLinks
RewriteEngine On

# Simple redirect for invite URLs
RewriteRule ^invite/([A-Z0-9]+)/?$ invite/index.html?code=$1 [L,QSA]

# Direct access to IBD3D files
# No rewrite needed - direct folder access

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]