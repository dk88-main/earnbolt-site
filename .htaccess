DirectoryIndex index.html index.php
Options +FollowSymLinks
RewriteEngine On

# Simple redirect for invite URLs
RewriteRule ^invite/([A-Z0-9]+)/?$ invite/index.html?code=$1 [L,QSA]

# Redirect IBD3D file requests to IBD3D.html page
RewriteRule ^IBD3D/(.+)$ IBD3D.html [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]